{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@byoagent/browser": [
        "../../byoa-extension/sdk/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests"
  ]
}
